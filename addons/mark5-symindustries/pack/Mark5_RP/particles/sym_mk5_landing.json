{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sym:mk5_landing",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/sym/particle/mk5_fx"
      }
    },
    "events": {
      "flash": {
        "particle_effect": {
          "effect": "sym:mk5_fx_impact_flash",
          "type": "emitter"
        }
      },
      "dust_puffs": {
        "particle_effect": {
          "effect": "sym:mk5_fx_dust_puffs",
          "type": "emitter"
        }
      },
      "debris": {
        "particle_effect": {
          "effect": "sym:mk5_fx_debris",
          "type": "emitter"
        }
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
