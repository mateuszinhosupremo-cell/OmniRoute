{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sym:mk5_scan_dome",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sym/particle/mk5_fx"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.rad = math.max(variable.radius ?? 32.0, 1.0);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.lt = math.clamp(variable.particle_age / variable.particle_lifetime, 0.0, 1.0);"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.4
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "rotation": "variable.particle_age * 40.0"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.rad / 0.92 * variable.lt + 0.05",
          "variable.rad / 0.92 * variable.lt + 0.05"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 384,
          "uv": [
            128,
            256
          ],
          "uv_size": [
            128,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.3,
          0.85,
          1.0,
          "0.35 * (1.0 - variable.lt * variable.lt) * math.clamp(variable.lt * 8.0, 0.0, 1.0)"
        ]
      }
    }
  }
}
