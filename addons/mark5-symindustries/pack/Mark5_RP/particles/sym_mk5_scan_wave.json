{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sym:mk5_scan_wave",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sym/particle/mk5_fx"
      }
    },
    "events": {
      "flash": {
        "particle_effect": {
          "effect": "sym:mk5_fx_flash_cyan",
          "type": "emitter"
        }
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.rad = math.max(variable.radius ?? 32.0, 1.0);"
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 15,
        "max_particles": 3
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_lifetime_events": {
        "creation_event": "flash"
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0.04,
          0
        ]
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.lt = math.clamp(variable.particle_age / variable.particle_lifetime, 0.0, 1.0);"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.4
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.rad / 0.9 * variable.lt + 0.05",
          "variable.rad / 0.9 * variable.lt + 0.05"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 256,
          "texture_height": 576,
          "uv": [
            0,
            256
          ],
          "uv_size": [
            128,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.25,
          0.9,
          1.0,
          "0.95 * (1.0 - variable.lt * variable.lt) * math.clamp(variable.lt * 10.0, 0.0, 1.0)"
        ]
      }
    }
  }
}
