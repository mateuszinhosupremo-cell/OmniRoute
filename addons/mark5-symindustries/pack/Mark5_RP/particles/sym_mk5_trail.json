{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sym:mk5_trail",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sym/particle/mk5_fx"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.dir ?? { variable.dir.x = 0.0; variable.dir.y = -1.0; variable.dir.z = 0.0; }; variable.vel ?? { variable.vel.x = 0.0; variable.vel.y = 0.0; variable.vel.z = 0.0; }; "
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 7
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_custom": {
        "offset": [
          "variable.dir.x * variable.particle_random_1 * 0.85 + math.random(-0.015, 0.015)",
          "variable.dir.y * variable.particle_random_1 * 0.85 + math.random(-0.015, 0.015)",
          "variable.dir.z * variable.particle_random_1 * 0.85 + math.random(-0.015, 0.015)"
        ],
        "direction": [
          "(variable.vel.x * 12.0)",
          "(variable.vel.y * 12.0 + 0.0001)",
          "(variable.vel.z * 12.0)"
        ]
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.lt = math.clamp(variable.particle_age / variable.particle_lifetime, 0.0, 1.0);"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.2 + variable.particle_random_2 * 0.06"
      },
      "minecraft:particle_initial_speed": "math.sqrt((variable.vel.x * 12.0) * (variable.vel.x * 12.0) + (variable.vel.y * 12.0 + 0.0001) * (variable.vel.y * 12.0 + 0.0001) + (variable.vel.z * 12.0) * (variable.vel.z * 12.0))",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 3.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.095 - 0.05 * variable.particle_random_1) * (1.0 - 0.4 * variable.lt)",
          "(0.095 - 0.05 * variable.particle_random_1) * (1.0 - 0.4 * variable.lt)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 576,
          "uv": [
            64,
            512
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "1.0 - 0.3 * variable.particle_random_1 - 0.2 * variable.lt",
          "1.0 - 0.05 * variable.particle_random_1",
          "math.clamp(0.66 + 0.3 * variable.particle_random_1 + 0.25 * variable.lt, 0.0, 1.0)",
          "(0.9 - 0.45 * variable.particle_random_1) * math.pow(1.0 - variable.lt, 1.3)"
        ]
      }
    }
  }
}
