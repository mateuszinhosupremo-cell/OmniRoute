{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sym:mk5_takeoff",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sym/particle/mk5_fx"
      }
    },
    "events": {
      "dust_ring": {
        "particle_effect": {
          "effect": "sym:mk5_fx_dust_ring",
          "type": "emitter"
        }
      },
      "dust_puffs": {
        "particle_effect": {
          "effect": "sym:mk5_fx_dust_puffs",
          "type": "emitter"
        }
      },
      "sparks": {
        "particle_effect": {
          "effect": "sym:mk5_fx_sparks_up",
          "type": "emitter"
        }
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 20,
        "max_particles": 2
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_lifetime_events": {
        "creation_event": [
          "dust_ring",
          "dust_puffs",
          "sparks"
        ]
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0.03,
          0
        ]
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.lt = math.clamp(variable.particle_age / variable.particle_lifetime, 0.0, 1.0);"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.5
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.3 + 2.6 * (1.0 - math.pow(1.0 - variable.lt, 2.5))",
          "0.3 + 2.6 * (1.0 - math.pow(1.0 - variable.lt, 2.5))"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 256,
          "texture_height": 384,
          "uv": [
            128,
            192
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1.0,
          "0.95 - 0.45 * variable.lt",
          "0.6 - 0.48 * variable.lt",
          "math.pow(1.0 - variable.lt, 1.3)"
        ]
      }
    }
  }
}
