{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sym:mk5_takeoff",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sym/particle/mk5_fx"
      }
    },
    "events": {
      "flash": {
        "particle_effect": {
          "effect": "sym:mk5_fx_impact_flash",
          "type": "emitter"
        }
      },
      "dust_ring": {
        "particle_effect": {
          "effect": "sym:mk5_fx_dust_ring",
          "type": "emitter"
        }
      },
      "sparks": {
        "particle_effect": {
          "effect": "sym:mk5_fx_sparks_up",
          "type": "emitter"
        }
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_lifetime_events": {
        "creation_event": [
          "flash",
          "dust_ring",
          "sparks"
        ]
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0.05,
          0
        ]
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.lt = math.clamp(variable.particle_age / variable.particle_lifetime, 0.0, 1.0);"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.36
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.35 + 3.1 * (1.0 - math.pow(1.0 - variable.lt, 2.2))",
          "0.35 + 3.1 * (1.0 - math.pow(1.0 - variable.lt, 2.2))"
        ],
        "facing_camera_mode": "emitter_transform_xz",
        "uv": {
          "texture_width": 256,
          "texture_height": 576,
          "uv": [
            0,
            384
          ],
          "uv_size": [
            128,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1.0,
          "1.0 - 0.3 * variable.lt",
          "0.78 - 0.6 * variable.lt",
          "math.pow(1.0 - variable.lt, 1.1)"
        ]
      }
    }
  }
}
