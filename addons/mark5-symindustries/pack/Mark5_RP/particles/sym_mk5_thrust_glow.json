{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sym:mk5_thrust_glow",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sym/particle/mk5_fx"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.vel ?? { variable.vel.x = 0.0; variable.vel.y = 0.0; variable.vel.z = 0.0; }; variable.pw = math.clamp(variable.power ?? 1.0, 0.0, 1.0);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "direction": [
          "(variable.vel.x * 20.0)",
          "(variable.vel.y * 20.0 + 0.0001)",
          "(variable.vel.z * 20.0)"
        ]
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.lt = math.clamp(variable.particle_age / variable.particle_lifetime, 0.0, 1.0);"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.12
      },
      "minecraft:particle_initial_speed": "math.sqrt((variable.vel.x * 20.0) * (variable.vel.x * 20.0) + (variable.vel.y * 20.0 + 0.0001) * (variable.vel.y * 20.0 + 0.0001) + (variable.vel.z * 20.0) * (variable.vel.z * 20.0))",
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.09 + 0.07 * variable.pw) * (1.0 + 0.12 * math.sin(variable.particle_age * 2400.0 + variable.particle_random_1 * 360.0))",
          "(0.09 + 0.07 * variable.pw) * (1.0 + 0.12 * math.sin(variable.particle_age * 2400.0 + variable.particle_random_1 * 360.0))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 384,
          "uv": [
            160,
            64
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1.0,
          0.95,
          "0.6 + 0.1 * variable.particle_random_1",
          "(0.6 + 0.2 * variable.pw) * (1.0 - variable.lt * variable.lt * variable.lt)"
        ]
      }
    }
  }
}
