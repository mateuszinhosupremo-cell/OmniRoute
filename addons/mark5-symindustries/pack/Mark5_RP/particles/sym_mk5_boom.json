{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sym:mk5_boom",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/sym/particle/mk5_fx"
      }
    },
    "events": {
      "vapor": {
        "particle_effect": {
          "effect": "sym:mk5_fx_vapor",
          "type": "emitter"
        }
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.dir ?? { variable.dir.x = 0.0; variable.dir.y = 0.0; variable.dir.z = 1.0; }; "
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 3
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_lifetime_events": {
        "creation_event": "vapor"
      },
      "minecraft:emitter_shape_custom": {
        "offset": [
          "0.0 - variable.dir.x * variable.particle_random_1 * 1.15",
          "0.0 - variable.dir.y * variable.particle_random_1 * 1.15",
          "0.0 - variable.dir.z * variable.particle_random_1 * 1.15"
        ],
        "direction": [
          "variable.dir.x + 0.0001",
          "variable.dir.y",
          "variable.dir.z + 0.0001"
        ]
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.lt = math.clamp(variable.particle_age / variable.particle_lifetime, 0.0, 1.0);"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.38 + variable.particle_random_2 * 0.07"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.2 + 3.4 * (1.0 - math.pow(1.0 - variable.lt, 2.6))) * (1.0 - 0.5 * variable.particle_random_1)",
          "(0.2 + 3.4 * (1.0 - math.pow(1.0 - variable.lt, 2.6))) * (1.0 - 0.5 * variable.particle_random_1)"
        ],
        "facing_camera_mode": "direction_z",
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "variable.dir.x + 0.0001",
            "variable.dir.y",
            "variable.dir.z + 0.0001"
          ]
        },
        "uv": {
          "texture_width": 256,
          "texture_height": 576,
          "uv": [
            0,
            384
          ],
          "uv_size": [
            128,
            128
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.93,
          0.97,
          1.0,
          "0.95 * math.pow(1.0 - variable.lt, 1.5) * (1.0 - 0.3 * variable.particle_random_1)"
        ]
      }
    }
  }
}
