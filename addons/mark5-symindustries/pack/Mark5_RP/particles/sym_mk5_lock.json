{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sym:mk5_lock",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sym/particle/mk5_fx"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.ls = math.max(variable.size ?? 1.8, 0.4);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.snap = math.pow(1.0 - math.clamp(variable.particle_age / 0.12, 0.0, 1.0), 2.0);"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.3
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_parametric": {
        "rotation": "45.0 * math.pow(1.0 - math.clamp(variable.particle_age / 0.12, 0.0, 1.0), 2.0)"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "variable.ls * 0.62 * (1.0 + 0.25 * variable.snap)",
          "variable.ls * 0.62 * (1.0 + 0.25 * variable.snap)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 576,
          "uv": [
            0,
            64
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1.0,
          0.18,
          0.15,
          "0.95 * math.clamp(variable.particle_age / 0.04, 0.0, 1.0) * math.clamp((variable.particle_lifetime - variable.particle_age) / 0.1, 0.0, 1.0)"
        ]
      }
    }
  }
}
