{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sym:mk5_power_up",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sym/particle/mk5_fx"
      }
    },
    "events": {
      "flash": {
        "particle_effect": {
          "effect": "sym:mk5_fx_flash_cyan",
          "type": "emitter"
        }
      },
      "ring_xz": {
        "particle_effect": {
          "effect": "sym:mk5_fx_ring_xz_cyan",
          "type": "emitter"
        }
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 10,
        "max_particles": 3
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.3
      },
      "minecraft:emitter_lifetime_events": {
        "creation_event": [
          "flash",
          "ring_xz"
        ]
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.lt = math.clamp(variable.particle_age / variable.particle_lifetime, 0.0, 1.0);"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.6
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.15 + 1.6 * (1.0 - math.pow(1.0 - variable.lt, 2.5))",
          "0.15 + 1.6 * (1.0 - math.pow(1.0 - variable.lt, 2.5))"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 576,
          "uv": [
            0,
            192
          ],
          "uv_size": [
            64,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.35,
          0.9,
          1.0,
          "math.pow(1.0 - variable.lt, 1.5)"
        ]
      }
    }
  }
}
