{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sym:mk5_power_down",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/sym/particle/mk5_fx"
      }
    },
    "events": {
      "arcs": {
        "particle_effect": {
          "effect": "sym:mk5_fx_arcs",
          "type": "emitter"
        }
      },
      "smoke": {
        "particle_effect": {
          "effect": "sym:mk5_fx_smoke_dark",
          "type": "emitter"
        }
      },
      "crackle": {
        "particle_effect": {
          "effect": "sym:mk5_spark",
          "type": "emitter"
        }
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 22
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.8
      },
      "minecraft:emitter_lifetime_events": {
        "creation_event": [
          "arcs",
          "smoke"
        ],
        "timeline": {
          "0.35": "crackle",
          "0.70": "crackle"
        }
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.15,
        "direction": "outwards"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.lt = math.clamp(variable.particle_age / variable.particle_lifetime, 0.0, 1.0);"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.3, 0.7)"
      },
      "minecraft:particle_initial_speed": "math.random(2.0, 5.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -9,
          0
        ],
        "linear_drag_coefficient": 2.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.06 * (1.0 - variable.lt) + 0.015",
          "0.06 * (1.0 - variable.lt) + 0.015"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 576,
          "uv": [
            192,
            64
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(0.7, 1.0, variable.lt)",
          "math.lerp(0.95, 0.55, variable.lt)",
          "math.lerp(1.0, 0.2, variable.lt)",
          "1.0 - variable.lt * variable.lt"
        ]
      }
    }
  }
}
