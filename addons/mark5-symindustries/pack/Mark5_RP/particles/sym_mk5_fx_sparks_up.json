          "0.055 * (1.0 - variable.lt) + 0.015",
          "0.055 * (1.0 - variable.lt) + 0.015"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 384,
          "uv": [
            192,
            64
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1.0,
          "0.9 - 0.4 * variable.lt",
          "0.45 - 0.35 * variable.lt",
          "1.0 - variable.lt * variable.lt"
        ]
      }
    }
