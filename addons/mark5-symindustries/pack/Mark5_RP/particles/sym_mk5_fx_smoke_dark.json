{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sym:mk5_fx_smoke_dark",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/sym/particle/mk5_fx"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 6
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.2,
        "direction": "outwards"
      },
      "minecraft:particle_initialization": {
        "per_render_expression": "variable.lt = math.clamp(variable.particle_age / variable.particle_lifetime, 0.0, 1.0);"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.0, 1.6)"
      },
      "minecraft:particle_initial_speed": "math.random(0.3, 0.8)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": "math.random(-30, 30)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.8,
          0
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.15 + 0.4 * math.sqrt(variable.lt)",
          "0.15 + 0.4 * math.sqrt(variable.lt)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 576,
          "uv": [
            "128 + math.floor(variable.particle_random_3 * 3.99) * 32",
            96
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_lighting": {},
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.12,
          0.12,
          0.13,
          "0.7 * (1.0 - variable.lt) * math.clamp(variable.lt * 8.0, 0.0, 1.0)"
        ]
      }
    }
  }
}
